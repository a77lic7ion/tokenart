{
  "_comment": "City definition. Districts map to providers via 'source'; the collector's measured numbers decide how built each one is. Edit this, or have a model generate it. Reload to apply.",
  "_schema": {
    "projects[].id": "unique string, used for ids",
    "projects[].name": "shown in the legend",
    "projects[].source": "provider id from usage.json: hermes | openrouter | zai | opencode | gemini. Omit for a district the AI adds itself.",
    "projects[].kind": "provider | project | idea. Free text for humans; the renderer ignores it.",
    "projects[].evidence": "WHY this district exists \u2014 a real thing it maps to. Required on any district the AI adds. No evidence, no district.",
    "projects[].reference": "{ metric, full } - the scale at which this district is fully built. Used only when the provider reports no limit of its own.",
    "projects[].tokenShare": "0..1 FALLBACK, used only when the provider returns no data. A placeholder, not a measurement.",
    "projects[].origin": "{ x, z } centre of the district on the island",
    "projects[].tier": "0 = ground (default). 1+ raises the district onto a deck that many levels up, with support columns and a rim, so the city grows UP as well as out. Set it only when a district has earned it.",
    "projects[].size": "{ width, depth } district footprint",
    "projects[].style": "one of: civic | laboratory | residential | archive | industrial",
    "projects[].accent": "one of: ink | amber | teal"
  },
