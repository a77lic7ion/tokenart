    "_schema": {
      "triggers[*].district": "district id matching city.json projects[].id",
      "triggers[*].metric": "usage.json metric: tokens | usd | percent | null",
      "triggers[*].threshold": "numeric threshold or null for key/evidence triggers",
      "triggers[*].action": "size_up | tier_up | key_added | evidence",
      "triggers[*].factor": "multiplier for size_up (default 1.25)",
      "triggers[*].evidence": "human-readable reason for the growth event",
      "expansionRate": "default size multiplier when threshold crossed",
      "tierThreshold": "usage multiplier for tier promotion",
      "growthBurstDelta": "daily token delta as fraction of reference triggers burst animation"
    }
